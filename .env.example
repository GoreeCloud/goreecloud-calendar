CALDAV_BASE_URL=https://dav.goreecloud.com
CALDAV_AUTH_MODE=service
CALDAV_USERNAME=
CALDAV_PASSWORD=
CALDAV_WRITE_ENABLED=false
UPSTREAM_TIMEOUT_SECONDS=10

# CALDAV_AUTH_MODE=service uses the configured service credentials for the current read-only foundation.
# CALDAV_AUTH_MODE=passthrough requires each request to authenticate with its own Radicale identity.
# CALDAV_WRITE_ENABLED must remain false until isolated Radicale write validation and production acceptance are complete.
# Write primitives only become available when both passthrough authentication and CALDAV_WRITE_ENABLED=true are configured.

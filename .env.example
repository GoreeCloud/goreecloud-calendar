# GoreeCloud Calendar development settings.
# Copy to .env for local development. Never commit real credentials.
GOREECLOUD_CALENDAR_ENVIRONMENT=development
GOREECLOUD_CALENDAR_CALDAV_BASE_URL=https://dav.goreecloud.com
GOREECLOUD_CALENDAR_CALDAV_TIMEOUT_SECONDS=15
GOREECLOUD_CALENDAR_CALDAV_MAX_QUERY_DAYS=62
GOREECLOUD_CALENDAR_SESSION_TTL_SECONDS=28800
GOREECLOUD_CALENDAR_SESSION_IDLE_SECONDS=3600
GOREECLOUD_CALENDAR_SESSION_MAX_TOTAL=200
GOREECLOUD_CALENDAR_SESSION_MAX_PER_USER=5
GOREECLOUD_CALENDAR_SESSION_COOKIE_SECURE=false
GOREECLOUD_CALENDAR_CALDAV_WRITE_ENABLED=false
GOREECLOUD_CALENDAR_TRUSTED_HOSTS=localhost,127.0.0.1,calendar.goreecloud.com
GOREECLOUD_CALENDAR_LOGIN_MAX_FAILURES=8
GOREECLOUD_CALENDAR_LOGIN_WINDOW_SECONDS=300
GOREECLOUD_CALENDAR_LOGIN_LOCKOUT_SECONDS=900

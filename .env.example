# GoreeCloud Calendar production configuration
CALDAV_BASE_URL=https://dav.goreecloud.com
CALDAV_WRITE_ENABLED=false
UPSTREAM_TIMEOUT_SECONDS=10
SESSION_TTL_SECONDS=28800
MAX_SESSIONS=256
SECURE_COOKIES=true
LOG_LEVEL=INFO

# Every calendar operation uses the individually authenticated Radicale identity held only
# in bounded application memory for the active session. Shared DAV service credentials are
# intentionally unsupported by the production application.
# CALDAV_WRITE_ENABLED remains false until isolated write acceptance, backup/recovery validation,
# manual Glaze UI/accessibility acceptance, and explicit production cutover approval are complete.

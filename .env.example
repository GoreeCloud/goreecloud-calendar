# GoreeCloud Calendar production configuration
CALDAV_BASE_URL=https://dav.goreecloud.com
CALDAV_AUTH_MODE=passthrough
CALDAV_USERNAME=
CALDAV_PASSWORD=
CALDAV_WRITE_ENABLED=false
UPSTREAM_TIMEOUT_SECONDS=10
SESSION_TTL_SECONDS=28800
MAX_SESSIONS=256
SECURE_COOKIES=true
TRUST_PROXY_HEADERS=false
LOG_LEVEL=INFO

# Production uses individually attributable Radicale identities through the application session layer.
# CALDAV_WRITE_ENABLED remains false until isolated write acceptance, backup/recovery validation,
# and explicit production cutover approval are complete.
# Service credentials remain available only as a compatibility/read-only mode and must not be used
# to provide multi-user production write access.
